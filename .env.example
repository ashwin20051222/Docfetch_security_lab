# ---- DocFetch Security Lab ----
# Copy to .env and adjust for your deployment.

# Backend
API_HOST=0.0.0.0
API_PORT=8000
# sqlite for local dev; postgres for production, e.g.
# postgresql+psycopg://docfetch:docfetch@localhost:5432/docfetch
DATABASE_URL=sqlite:///./data/docfetch.db
DATA_DIR=./data

# Document handling
MAX_DOWNLOAD_SIZE=104857600          # 100 MB max remote download
MAX_UPLOAD_SIZE=52428800             # 50 MB max upload
DOWNLOAD_TTL_DAYS=14                 # documents expire after this many days
FETCH_TIMEOUT_SECONDS=25
MAX_REDIRECTS=5

# Rate limiting (requests per minute per client IP per endpoint group)
RATE_LIMIT_PER_MINUTE=30
# Larger burst allowance for download streaming
DOWNLOAD_RATE_PER_MINUTE=60

# Security Lab
# Comma-separated base URLs that are ALWAYS treated as authorized lab targets.
# External hosts are rejected unless listed here by the deployment owner.
AUTHORIZED_LAB_TARGETS=http://127.0.0.1:9101,http://127.0.0.1:9102,http://127.0.0.1:9103
LAB_TEST_TIMEOUT_SECONDS=20

# Optional API token. When set, mutating Security Lab endpoints require:
#   Authorization: Bearer <LAB_ADMIN_TOKEN>
# When empty, the UI reports: "Authentication is not configured."
LAB_ADMIN_TOKEN=

# Optional: base URL the browser uses to reach the API (for web builds).
# Leave empty to resolve from VITE_* in the web app instead.
API_BASE_URL=

# Environment: development | production
APP_ENV=development
LOG_LEVEL=INFO