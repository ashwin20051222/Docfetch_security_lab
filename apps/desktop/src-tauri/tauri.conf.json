{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScribSave",
  "version": "0.1.0",
  "identifier": "com.scribsave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace apps/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace apps/web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScribSave",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "pacman"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}